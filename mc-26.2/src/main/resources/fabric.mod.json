{
  "schemaVersion": 1,
  "id": "official_capes",
  "version": "${version}",
  "name": "ZenCapes",
  "description": "Client-side Minecraft mod featuring all authentic official Mojang capes, realistic 16-segment cloth physics, Obsidian Dark GUI, keybindings and commands.",
  "authors": [
    "Zentrix"
  ],
  "contact": {
    "homepage": "https://github.com/Z3ntrix603/ZenCapes"
  },
  "license": "MIT",
  "icon": "assets/official_capes/textures/capes/minecon_2011.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.officialcapes.OfficialCapesClient"
    ]
  },
  "mixins": [
    "official_capes.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=21",
    "fabric-api": "*"
  }
}
